<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="oval">

            <solid android:color="#315FCC" />

            <stroke
                android:width="2dp"
                android:color="#8AB4FF" />

        </shape>
    </item>

    <item>
        <shape android:shape="oval">

            <solid android:color="#2367E8" />

            <stroke
                android:width="2dp"
                android:color="#5D8FFF" />

        </shape>
    </item>

</selector>